</article>

@code {
    private const int RecropNeighbours = 8;
    private Metrics? _m;
    private PallorModel? _model;

    protected override async Task OnInitializedAsync()
    {
        _m = await Data.Metrics;
        _model = await Data.Model;
    }
}
